import yaml

configfile: "pipeline/config/species.yaml"

SPECIES_NAMES = [s["name"].replace(" ", "_") for s in config["species"] if s["tier"] == 1]
SPECIES_ACCESSIONS = {s["name"].replace(" ", "_"): s["accession"] for s in config["species"] if s["tier"] == 1}

include: "rules/download.smk"
include: "rules/preprocess.smk"

rule all:
    input:
        "data/manifest/provenance_log.csv",
        expand("data/{species}.bed", species=SPECIES_NAMES),
        expand("data/{species}.pep.fa", species=SPECIES_NAMES),
        expand("data/{species}_qc.json", species=SPECIES_NAMES)
